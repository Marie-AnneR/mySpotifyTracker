# Environnement de l'app (development / preview / production)
NEXT_PUBLIC_APP_ENV=development

# Doit être une adresse loopback (Spotify refuse "localhost") et être déclarée dans le dashboard Spotify
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://[::1]:3000/api/auth/callback
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Base Neon (Postgres) — SECRET, sans préfixe NEXT_PUBLIC_ : jamais envoyée au navigateur.
# Créées par Vercel → Storage → Neon ; en local : `vercel env pull .env.local` ou copier depuis Vercel
DATABASE_URL=
# Connexion directe (sans pooler), utilisée par drizzle-kit pour les migrations
DATABASE_URL_UNPOOLED=

# Snapshots automatiques — SECRETS, à générer avec : openssl rand -base64 32
# Clé de chiffrement des refresh tokens stockés en base. La changer rend les tokens
# existants illisibles : les utilisateurs devront réactiver les snapshots automatiques.
TOKEN_ENCRYPTION_KEY=
# Secret envoyé par Vercel Cron (en-tête Authorization) pour appeler /api/cron/snapshots
CRON_SECRET=
